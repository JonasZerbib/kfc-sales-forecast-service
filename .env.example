# HTTP
PORT=3000

# Database — use DB_HOST=db when running inside Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=kfc_forecast

# Forecast scheduler (cron expression)
# Default: every day at 02:00 AM
FORECAST_CRON_SCHEDULE=0 2 * * *

# Number of past days used for the AVG calculation (1–14)
LOOKBACK_DAYS=14

# Set to true to run a forecast generation immediately on startup (useful for demos)
RUN_FORECAST_ON_STARTUP=true

